@echo off
rem PACE / CAPITAL launcher for Windows. Pure batch - no Python, no install.
rem
rem PACE.EXE is a 16-bit MS-DOS binary (FoxPro 2.5 DOS runtime). 64-bit Windows
rem dropped NTVDM, so it cannot run natively; this mounts the folder it lives in
rem as the DOS C: drive inside DOSBox-X and starts the app.
rem
rem Every path compiled into PACE.EXE is drive-less and root-anchored
rem (\capital\..., \pace\...), so the folder holding CAPITAL\ and PACE\ has to be
rem the root of the DOS drive. That is what "mount c" below does.
rem
rem   PACE.cmd            launch (or just double-click)
rem   PACE.cmd --check    verify setup, run nothing
rem   PACE.cmd --shell    mount and stop at the DOS prompt
rem   PACE.cmd --conf     print the generated DOSBox-X config

setlocal EnableExtensions EnableDelayedExpansion

set "ROOT=%~dp0"
if "%ROOT:~-1%"=="\" set "ROOT=%ROOT:~0,-1%"
set "PROGRAM_DIR=CAPITAL"
set "DATA_DIR=PACE"
set "MAIN_EXE=PACE.EXE"
set "TOOLS_DIR=FOX25"

set "MODE=run"
if /i "%~1"=="--check" set "MODE=check"
if /i "%~1"=="--shell" set "MODE=shell"
if /i "%~1"=="--conf"  set "MODE=conf"
if not "%~1"=="" if "%MODE%"=="run" (
    echo usage: %~nx0 [--check^|--shell^|--conf]
    call :pause_if_clicked
    exit /b 2
)

rem ------------------------------------------------------------- verify the tree

set "FAILED="
if not exist "%ROOT%\%PROGRAM_DIR%\" call :fail "missing %PROGRAM_DIR%\ next to this launcher"
if not exist "%ROOT%\%DATA_DIR%\"    call :fail "missing %DATA_DIR%\ next to this launcher"
if not exist "%ROOT%\%PROGRAM_DIR%\%MAIN_EXE%" call :fail "missing %PROGRAM_DIR%\%MAIN_EXE%"

for %%F in (CONTROL.PRO BLACK.BOX CO.DBF LAB.LBX HELP.AID INFO.AID FOXUSER.DBF) do (
    if not exist "%ROOT%\%PROGRAM_DIR%\%%F" echo warning: missing %PROGRAM_DIR%\%%F
)

set "SOCIETIES="
for /d %%D in ("%ROOT%\%DATA_DIR%\*") do set "SOCIETIES=!SOCIETIES! %%~nxD"
if not defined SOCIETIES echo warning: no society folder in %DATA_DIR%\ - use CREATE SOCIETY in the app

set "FOXPATH="
rem Optional: a FoxPro 2.5 install for the archived developer tools in attic\.
rem The app itself never needs it, so this is silent unless the folder is
rem present but unusable.
if exist "%ROOT%\%TOOLS_DIR%\" (
    set "FOXPATH=set PATH=%%PATH%%;C:\%TOOLS_DIR%"
    if not exist "%ROOT%\%TOOLS_DIR%\FOXPROX.EXE" echo warning: %TOOLS_DIR%\ exists but has no FOXPROX.EXE
)

rem --------------------------------------------------------- locate the emulator

set "EMU="
set "EMU_LABEL="
call :try_emu "%ROOT%\emu\win64\dosbox-x.exe"      "bundled win64"
call :try_emu "%ROOT%\emu\win32\dosbox-x.exe"      "bundled win32"
if not defined EMU (
    for %%P in (dosbox-x.exe) do if not defined EMU (
        if not "%%~$PATH:P"=="" call :try_emu "%%~$PATH:P" "%%~$PATH:P"
    )
)
call :try_emu "%ProgramFiles%\DOSBox-X\dosbox-x.exe"             "%ProgramFiles%\DOSBox-X"
call :try_emu "%ProgramFiles(x86)%\DOSBox-X\dosbox-x.exe"        "%ProgramFiles(x86)%\DOSBox-X"
call :try_emu "%LOCALAPPDATA%\DOSBox-X\dosbox-x.exe"             "%LOCALAPPDATA%\DOSBox-X"
call :try_emu "%LOCALAPPDATA%\Programs\DOSBox-X\dosbox-x.exe"    "%LOCALAPPDATA%\Programs\DOSBox-X"

if not defined EMU call :fail "DOSBox-X not found - put dosbox-x.exe in emu\win64\, or install it: winget install joncampbell123.DOSBox-X"

rem ------------------------------------------------------------ build the config

set "CONF=%TEMP%\pace-%RANDOM%.conf"
> "%CONF%" echo # Generated by PACE.cmd - rewritten on every launch, do not edit.
>>"%CONF%" echo [sdl]
>>"%CONF%" echo windowresolution = 1280x800
>>"%CONF%" echo output           = direct3d
>>"%CONF%" echo.
>>"%CONF%" echo [dosbox]
>>"%CONF%" echo machine = svga_s3
>>"%CONF%" echo memsize = 16
>>"%CONF%" echo title   = PACE / CAPITAL
>>"%CONF%" echo.
>>"%CONF%" echo [cpu]
>>"%CONF%" echo core    = dynamic
>>"%CONF%" echo cputype = pentium
>>"%CONF%" echo cycles  = max
>>"%CONF%" echo.
>>"%CONF%" echo [render]
>>"%CONF%" echo aspect = true
>>"%CONF%" echo scaler = none
>>"%CONF%" echo.
>>"%CONF%" echo [dos]
>>"%CONF%" echo ver = 7.1
>>"%CONF%" echo rem The FoxPro 2.5 DOS extender needs XMS.
>>"%CONF%" echo xms = true
>>"%CONF%" echo ems = true
>>"%CONF%" echo file access tries UTF-8 = true
>>"%CONF%" echo.
>>"%CONF%" echo [ipx]
>>"%CONF%" echo ipx = false
>>"%CONF%" echo.
>>"%CONF%" echo [autoexec]
>>"%CONF%" echo chcp 437
>>"%CONF%" echo mount c "%ROOT%"
>>"%CONF%" echo c:
>>"%CONF%" echo set PATH=%%PATH%%;C:\%PROGRAM_DIR%
if defined FOXPATH >>"%CONF%" echo !FOXPATH!
>>"%CONF%" echo cd \%PROGRAM_DIR%
if "%MODE%"=="shell" (
    >>"%CONF%" echo echo.
    >>"%CONF%" echo echo C: is %ROOT%
    >>"%CONF%" echo echo Type:  pace -t     to start the app
    >>"%CONF%" echo echo.
) else (
    >>"%CONF%" echo del *.tmp
    >>"%CONF%" echo pace -t
    >>"%CONF%" echo exit
)

if "%MODE%"=="conf" (
    type "%CONF%"
    del "%CONF%" >nul 2>&1
    call :pause_if_clicked
    exit /b 0
)

rem ------------------------------------------------------------------- report/run

echo root      : %ROOT%
if defined SOCIETIES (echo societies :!SOCIETIES!) else (echo societies : ^(none^))
echo emulator  : %EMU_LABEL%

if defined FAILED (
    del "%CONF%" >nul 2>&1
    call :pause_if_clicked
    exit /b 1
)

if "%MODE%"=="check" (
    echo ok        : ready to run
    del "%CONF%" >nul 2>&1
    call :pause_if_clicked
    exit /b 0
)

"%EMU%" -conf "%CONF%"
set "RC=%ERRORLEVEL%"
del "%CONF%" >nul 2>&1
if not "%RC%"=="0" call :pause_if_clicked
exit /b %RC%

rem -------------------------------------------------------------- subroutines

:try_emu
if defined EMU exit /b 0
if exist "%~1" (
    set "EMU=%~1"
    set "EMU_LABEL=%~2"
)
exit /b 0

:fail
echo error     : %~1 1>&2
set "FAILED=1"
exit /b 0

rem Double-clicked windows close instantly, which hides every message. Hold the
rem window open only when this was not started from an existing console.
:pause_if_clicked
echo %CMDCMDLINE% | find /i "/c" >nul && pause
exit /b 0
